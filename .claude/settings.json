{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/inspect-evidence.sh",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/rustfmt-on-edit.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/affected-crate-tests.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/retail-grounding-reminder.sh",
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Glob"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/session-edits-record.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/session-edits-bash-post.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/lsb-boundary-reminder.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/comment-rot-reminder.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/session-edits-bash-pre.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/commit-nudge-start.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0; for hook in \"$root/.agents/hooks/ste100-reminder.py\" \"$(dirname \"$common\")/.agents/hooks/ste100-reminder.py\"; do if [ -f \"$hook\" ]; then python3 \"$hook\"; exit $?; fi; done",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/stop-dispatcher.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0; for hook in \"$root/.agents/hooks/ste100-reminder.py\" \"$(dirname \"$common\")/.agents/hooks/ste100-reminder.py\"; do if [ -f \"$hook\" ]; then python3 \"$hook\"; exit $?; fi; done",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(docker exec server-database-1 mariadb -uxiadmin -ppassword xidb -e \"DELETE FROM accounts_sessions WHERE charid=*)",
      "Bash(bd show *)",
      "Bash(bd list *)",
      "Bash(bd search *)",
      "Bash(bd ready*)",
      "Bash(bd stats*)",
      "Bash(gh release view *)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push origin :*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(gh release delete *)",
      "Bash(bd dolt push*)"
    ]
  }
}
