{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "farm": {
      "model": "llama.cpp/qwen-3.6-35b-a3b",
      "prompt": "{file:./.claude/agents/farm_logic.md}"
    }
  },
  "mcp": {
    "ffxi": {
      "type": "local",
      "command": [
        "cargo",
        "run",
        "--release",
        "--manifest-path",
        "../Cargo.toml",
        "-p",
        "kuluu-mcp"
      ],
      "environment": {
        "FFXI_SERVER": "{env:FFXI_SERVER}",
        "FFXI_AUTH_PORT": "{env:FFXI_AUTH_PORT}",
        "FFXI_DATA_PORT": "{env:FFXI_DATA_PORT}",
        "FFXI_VIEW_PORT": "{env:FFXI_VIEW_PORT}",
        "FFXI_USER": "{env:FFXI_USER}",
        "FFXI_PASS": "{env:FFXI_PASS}",
        "FFXI_CHAR": "{env:FFXI_CHAR}",
        "FFXI-RELAY_LISTEN": "auto",
        "RUST_LOG": "info"
      }
    },
    "ffxi-attach": {
      "type": "local",
      "command": [
        "cargo",
        "run",
        "--release",
        "--manifest-path",
        "../Cargo.toml",
        "-p",
        "kuluu-mcp"
      ],
      "environment": {
        "FFXI_ATTACH": "auto",
        "FFXI_SERVER": "{env:FFXI_SERVER}",
        "FFXI_AUTH_PORT": "{env:FFXI_AUTH_PORT}",
        "FFXI_DATA_PORT": "{env:FFXI_DATA_PORT}",
        "FFXI_VIEW_PORT": "{env:FFXI_VIEW_PORT}",
        "RUST_LOG": "info"
      }
    }
  }
}
