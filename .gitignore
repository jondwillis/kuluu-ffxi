# Rust workspace artifacts (defense-in-depth; component .gitignores cover this too)
**/target/
**/*.rs.bk

# Working backups made during edits (*.rs.bak, *.rs.bak-<tag>) — local only.
**/*.rs.bak*

# Root release exe — build artifact, ~120MB (over GitHub's 100MB blob limit).
# Regenerate: cargo build -p kuluu --release && logs/sync_exe.ps1
/kuluu.exe

# Node / abandoned scaffolds
**/node_modules/

# Python bytecode (scripts/*.py)
**/__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
*.swo
.idea/

# Claude Code per-user settings + plugin runtime state
.claude/settings.local.json
.claude/.*/
.claude/worktrees/

# OpenCode / sibling-agent harness session state — ephemeral, per-user.
.omo/
.omc/
.functional-emotions

# Environment / credentials
.env
.env.local
*.env

# Logs
*.log
log/
/logs/

# jacq build output — regenerate via `jacq build` in ffxi-agent/.
ffxi-agent/dist/

# FFXI client DATs — SE-copyrighted, NEVER commit.
vendor/game-files/

# xi-tinkerer — vendored as AGPL-3 reference only (read-only, never linked).
vendor/xi-tinkerer/

# RZN MapViewer — STRICT cite-only, all-rights-reserved. Never copy/derive/link.
vendor/RZN-mapviewer/

# XIM browser FFXI client (GPL-3) — read-only reference, NEVER commit.
research/xim/
# Phoenix server (GPL-3) — private upstream, clone locally.
research/Phoenix/
/xim/

# WASM build outputs — ~150MB, over GitHub blob limit. Regenerate locally.
ffxi-viewer-wasm/dist/
profile.json.gz

# Container-built Linux binaries (docker/build-linux.sh)
/dist/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# skill-creator eval scratch (transient benchmark runs)
.agents/skills/*-workspace/

# Verification evidence marker — per-machine, ephemeral.
.verify/

# Retail-client captures — SE-copyrighted, reference only, NEVER commit.
/artifacts/retail/
artifacts/

# Chrome/Perfetto traces from --features trace runs
/trace-*.json

# Editor/tool backups
*.bak

# Session scratch + crash dumps (rustc ICE logs, saved pre-rewrite file versions) — local only.
archive/scratch/
