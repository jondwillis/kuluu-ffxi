#!/usr/bin/env bash
# Pre-push gate over the cheap half of .github/workflows/ci.yml, so the common
# red-CI causes are caught locally. Checks the working tree (what you'd push
# next) -- not the commits, so a peer's in-progress edits are graded too.
#
# A green hook is not a green CI: the `test` and `enhanced` stages run only in
# CI, and `wasm` runs here only when the push touches its build graph.
#
# Bypass once:   git push --no-verify
# Bypass via env: SKIP_PREPUSH=1 git push
# Skip the slow passes: PREPUSH_FAST=1 git push   (runs harness, comments, fmt, state contracts and the target/ sweep; skips wasm, install conformance and clippy)
#
# Install (per clone): scripts/install-hooks.sh   (sets core.hooksPath=.githooks)
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [[ "${SKIP_PREPUSH:-}" == "1" ]]; then
  echo "pre-push: skipped (SKIP_PREPUSH=1)"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# A cargo stage can die for reasons that have nothing to do with the diff, because
# several agent sessions, rust-analyzer and this gate share one target/: EAGAIN
# (os error 35) when the machine runs out of thread/process headroom, or the
# jobserver stall cargo-guard.sh kills. Every per-stage message below names a code
# cause, so retry serially before blaming the diff for the environment.
checks_retry_contention() {
  local stage="$1" log
  log=$(mktemp)
  if scripts/checks.sh "$stage" 2>&1 | tee "$log"; then
    rm -f "$log"
    return 0
  fi
  if grep -qE 'os error 35|WEDGE DETECTED' "$log"; then
    rm -f "$log"
    echo "pre-push: $stage lost to build contention, not your diff; retrying with one job" >&2
    CARGO_BUILD_JOBS=1 scripts/checks.sh "$stage"
    return $?
  fi
  rm -f "$log"
  return 1
}

if command -v bd >/dev/null 2>&1; then
  bd hooks run pre-push "$@"
fi

# Delegate the actual fmt/clippy invocation to the shared script so this gate
# and CI run byte-identical flags. A green hook therefore proves a green CI
# fmt/clippy. The state contract runs locally; the complete workspace test
# suite runs in CI.
if ! scripts/checks.sh harness; then
  echo "pre-push: ✗ harness config — see .agents/AGENTS.md (or 'git push --no-verify' to bypass)" >&2
  exit 1
fi

scripts/checks.sh readme

if ! scripts/checks.sh comments; then
  echo "pre-push: ✗ comments — line-pinned or dangling citations; see .agents/skills/comment-discipline/SKILL.md (or 'git push --no-verify' to bypass)" >&2
  exit 1
fi

if ! scripts/checks.sh literals; then
  echo "pre-push: ✗ literals — a value that already has a named const was re-typed; import the const (or 'git push --no-verify' to bypass)" >&2
  exit 1
fi

if ! scripts/checks.sh fmt; then
  echo "pre-push: ✗ formatting — run 'cargo fmt --all' (or 'git push --no-verify' to bypass)" >&2
  exit 1
fi

if ! checks_retry_contention contracts; then
  echo "pre-push: state contracts failed" >&2
  exit 1
fi

# target/ hygiene, never a gate: evicting stale build artifacts can't make a
# push wrong, and a sweep failure must not block one. Runs before the slow
# passes so their fresh artifacts aren't candidates for eviction.
scripts/checks.sh sweep || echo "pre-push: sweep failed (ignored)" >&2

if [[ "${PREPUSH_FAST:-}" == "1" ]]; then
  echo "pre-push: ok (harness, comments, fmt and state contracts; PREPUSH_FAST=1)"
  exit 0
fi

# The browser viewer is the one CI target no local workflow ever builds, so a
# module referenced across a #[cfg(not(target_arch = "wasm32"))] gate compiles
# natively and only fails in CI. kuluu-render is the sole workspace crate that
# carries those gates; kuluu-snapshot and kuluu-viewer-wasm are the wire type it
# renders from and the crate under check. A dependency that itself stops
# building for wasm (ffxi-dat growing a native-only dep, say) still escapes to
# CI -- that break lives outside these three trees and is far rarer than the
# gate-crossing one this catches.
wasm_paths=$(git diff --name-only @{push}.. -- kuluu-render kuluu-snapshot \
  kuluu-viewer-wasm 2>/dev/null) || wasm_paths='(no @{push} to diff against)'
if [[ -n "$wasm_paths" ]]; then
  if ! checks_retry_contention wasm; then
    echo "pre-push: ✗ wasm — the browser viewer does not build; an item is likely gated out of wasm32 but referenced from ungated code (or 'git push --no-verify' to bypass)" >&2
    exit 1
  fi
fi

# Install conformance (every client install on disk) only when the commits
# being pushed touch DAT-facing code; with no upstream to diff against, run it.
install_paths=$(git diff --name-only @{push}.. -- ffxi-dat ffxi-proto/build.rs \
  kuluu-session/src/event_dialog.rs kuluu-render/src/look_resolver.rs \
  kuluu-render/src/ffxi_actor_render.rs vendor/server 2>/dev/null) || install_paths='(no @{push} to diff against)'
if [[ -n "$install_paths" ]]; then
  if ! checks_retry_contention install; then
    echo "pre-push: ✗ install conformance — a client install on disk disagrees with the DAT-facing code (or 'git push --no-verify' to bypass)" >&2
    exit 1
  fi
fi

if ! checks_retry_contention clippy; then
  echo "pre-push: ✗ clippy — fix the warnings above (or 'git push --no-verify' to bypass)" >&2
  exit 1
fi

echo "pre-push: ok"
